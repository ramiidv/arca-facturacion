{
  "name": "@ramiidv/arca-facturacion",
  "version": "3.0.0",
  "description": "SDK para Facturación Electrónica con ARCA (ex AFIP) - WSFE, WSFEX, CAEA, QR",
  "author": "ramiidv",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llm.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs Arca ArcaResultadoIncierto ArcaWSFEError armarComprobante resolverCbteTipo CbteTipo FileTicketStorage",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": [
    "afip",
    "arca",
    "factura-electronica",
    "facturacion",
    "wsfe",
    "wsfex",
    "wsaa",
    "argentina",
    "cae",
    "caea",
    "invoice",
    "factura",
    "mipyme",
    "fce",
    "soap",
    "tax",
    "electronic-invoice",
    "padron",
    "exportacion",
    "qr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiidv/arca-facturacion.git"
  },
  "homepage": "https://arca-sdk.dev/facturacion",
  "bugs": {
    "url": "https://github.com/ramiidv/arca-facturacion/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ramiidv/arca-common": "^0.3.0",
    "fast-xml-parser": "^5.5.9",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/node-forge": "^1.3.14",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "module": "./dist/esm/index.js"
}
